# Backend Configuration
DATABASE_URL=postgresql://digitaltwin:password@localhost:5432/digitaltwin_db
REDIS_URL=redis://localhost:6379
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# API Configuration
API_TITLE=DiabetesTwin API
API_VERSION=1.0.0
API_DESCRIPTION=Real-time diabetes monitoring and prediction

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19000

# Logging
LOG_LEVEL=INFO

# ML Models
MODELS_DIR=./models
DATA_DIR=./data

# Database
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Security
CORS_ALLOW_CREDENTIALS=true
